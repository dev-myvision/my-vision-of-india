# Set these in Vercel: Project > Settings > Environment Variables (Production).
# For local work, copy this file to .env.local.

# The site's public address, with no trailing slash. Leave it unset until the domain is
# connected: on Vercel the site then uses its *.vercel.app production address.
SITE_URL=

# Google Search Console > Add property > URL prefix > HTML tag: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=
